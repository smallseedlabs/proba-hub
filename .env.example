# Server Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Database Configuration
DATABASE_URL=postgresql://proba:proba@localhost:5432/proba_hub
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Authentication (Development Only)
JWT_SECRET=dev-secret-change-in-production
JWT_EXPIRES_IN=7d

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# SSE Configuration
SSE_HEARTBEAT_INTERVAL_MS=30000

# Ask Configuration
ASK_EXPIRY_CHECK_INTERVAL_MS=60000

# Mock Brain Configuration
MOCK_BRAIN_SCENARIO=happy_path
