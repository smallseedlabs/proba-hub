# Server Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Database Configuration
DATABASE_URL=postgresql://proba:replace-with-your-POSTGRES_PASSWORD@localhost:5432/proba_hub
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis Configuration
# Redis always needs a password: docker-compose.yml starts Redis with an ACL user (REDIS_USER, REDIS_PASSWORD) and no anonymous access.
#   redis://<user>:<password>@host:6379    plain TCP (inside a private network only)
#   rediss://<user>:<password>@host:6380   TLS (certificate and host name are verified; for a private CA set NODE_EXTRA_CA_CERTS)
# With NODE_ENV=production a REDIS_URL without a password makes the Hub refuse to start (RedisPasswordRequiredError).
# Use a URL-safe password (hex: `openssl rand -hex 24`) or percent-encode it.
# `scripts/generate-local-env.sh` writes a whole local .env (random passwords) that matches docker-compose.yml.
REDIS_URL=redis://proba:replace-with-your-REDIS_PASSWORD@localhost:6379
# Read by docker compose only (it builds the URLs of the containers from them):
# POSTGRES_PASSWORD=
# REDIS_USER=proba
# REDIS_PASSWORD=

# Authentication
# Users sign in with Firebase Authentication in proba-web. The Hub verifies the
# Firebase ID token against Google's public keys (no service account needed)
# and exchanges it for its own revocable session token (POST /v1/auth/session).
# FIREBASE_PROJECT_ID is the Firebase project ID (Project settings > General).
# Sign-in is disabled (503) while it is empty.
FIREBASE_PROJECT_ID=
# Optional: only verified emails in these domains may sign in (comma-separated).
# Empty allows every user of the Firebase project.
AUTH_ALLOWED_EMAIL_DOMAINS=
# JWT_SECRET signs Hub session tokens. Use a long random value outside
# development (e.g. `openssl rand -base64 48`). Tokens are also checked against
# the sessions table, so sign-out (POST /v1/auth/logout) revokes them immediately.
# JWT_SECRET_FILE (path to a file, e.g. /run/secrets/jwt_secret) takes precedence.
# With NODE_ENV=production the Hub refuses to start on this development default.
JWT_SECRET=dev-secret-change-in-production
JWT_EXPIRES_IN=7d
# Failed session exchanges allowed per IP per window.
AUTH_SESSION_RATE_LIMIT_MAX=30
AUTH_SESSION_RATE_LIMIT_WINDOW_MS=900000
# Password-less POST /dev/login for local development and tests. Never
# registered when NODE_ENV=production; set to false to disable it elsewhere too.
DEV_LOGIN_ENABLED=true

# CORS Configuration (comma-separated list of allowed origins)
CORS_ORIGIN=http://localhost:5173

# SSE Configuration
SSE_HEARTBEAT_INTERVAL_MS=30000

# Ask Configuration
ASK_EXPIRY_CHECK_INTERVAL_MS=60000

# Brain
# BRAIN_PROVIDER picks the adapter behind src/brain/port.ts: mock (default) or deepseek.
BRAIN_PROVIDER=mock
# Scripted scenario run by the mock provider
MOCK_BRAIN_SCENARIO=happy_path
# deepseek provider: the key is required (DEEPSEEK_API_KEY_FILE, a mounted secret, wins over DEEPSEEK_API_KEY).
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_TIMEOUT_MS=30000
# Limits on what a model-backed brain may propose (USD; 0 = no cap). Over-limit proposals are replaced by a short reply.
# BRAIN_MAX_OUTPUT_TOKENS=1500
# BRAIN_MAX_TOOL_CALLS=2
# BRAIN_MAX_ACTION_SPEND=1000
# BRAIN_MAX_PLAN_BUDGET=10000
# Comma-separated tool names the brain may propose; empty = any name (every call still needs approval)
# BRAIN_ALLOWED_TOOLS=
# BRAIN_MAX_CONTEXT_MESSAGES=20

# --- Gateway orchestration (proba-llm-gateway) ---
# When GATEWAY_URL is set (or GATEWAY_ENABLED=true), Hub posts tenant-scoped
# runs to the gateway instead of mock/DeepSeek. The gateway owns context,
# preflight and the tool loop. Unset = disabled (existing mock/deepseek).
# Enabled with an empty URL, or combined with BRAIN_PROVIDER=deepseek, refuses to start.
# There is no silent fallback to a local model if the gateway is down.
# Durable bindings (original command, idempotencyKey, askId, runId) are stored in
# Postgres table gateway_runs (migration 006). Operator landing URLs and displayed
# research_review artifacts are stored on goals/asks (migration 007). Apply with
# the Hub migrator. Opt-in only: do not set GATEWAY_URL in compose until
# HUB_GATEWAY_PRIVATE_KEY_FILE matches the gateway's HUB_SERVICE_PUBLIC_KEY_FILE.
# That path can call a live LLM. Research HTTP fetch stays a gateway flag
# (RESEARCH_HTTP_FETCH, default off); Hub tests use a FAKE in-process gateway.
# GATEWAY_ENABLED=
# GATEWAY_URL=http://127.0.0.1:3700
# GATEWAY_TIMEOUT_MS=90000
# PKCS#8 PEM matching the gateway's HUB_SERVICE_PUBLIC_KEY_FILE (iss=proba-hub, aud=proba-gateway, sub=hub, TTL≤120s).
# HUB_GATEWAY_PRIVATE_KEY_FILE=
# HUB_GATEWAY_KEY_ID=hub-gw-1
# HUB_GATEWAY_TOKEN_TTL_SECONDS=120

# --- Analytics and action bot (docs/ANALYTICS_ACTIONS.md) ---
# Needs the gateway above. Scheduled reviews are OFF by default; manual reviews via
# POST /v1/analytics/campaigns/:id/review still work. Proposals are never executed
# automatically: only an owner approve on /v1/analytics/proposals/:id/decision runs one.
# ANALYTICS_SCHEDULE_ENABLED=false
# ANALYTICS_REVIEW_CADENCE_MS=21600000
# ANALYTICS_SCHEDULER_TICK_MS=300000
# Campaign reviewer: brain (system-initiated brain run that picks its own next check) or rules (fixed cadence).
# ANALYTICS_REVIEWER=brain
# Outer bounds, tighten-only vs the gateway locks (1h..168h, max 20% automatic change). Looser values are ignored.
# ANALYTICS_REVIEW_MIN_CHECK_HOURS=6
# ANALYTICS_REVIEW_MAX_CHECK_HOURS=72
# ANALYTICS_REVIEW_MAX_AUTO_CHANGE_PCT=20

# --- Context bridge (act-as assertions + internal reads + brain wiring) ---
# Feature flag: when unset, on iff CONTEXT_BRIDGE_URL is set. Explicit false keeps
# the legacy in-Hub context (local only). Production refuses enabled=false or empty URL.
# CONTEXT_BRIDGE_ENABLED=
# Base URL of the context bridge (POST /v1/context/build). Required in production.
# CONTEXT_BRIDGE_URL=
# CONTEXT_BRIDGE_TIMEOUT_MS=10000
# CONTEXT_BRIDGE_FAILURE_THRESHOLD=5
# CONTEXT_BRIDGE_CIRCUIT_OPEN_MS=30000
# Hybrid needs rounds per brain step (default 2).
# CONTEXT_BRIDGE_MAX_NEED_ROUNDS=2
# On bridge failure: clarify (default) or hold (no brain output). Never an in-process builder.
# CONTEXT_BRIDGE_ON_FAILURE=clarify
# Accept the context-reader role on /v1/internal/* (requires the key files below).
# HUB_CONTEXT_READER_ENABLED=false
# PKCS#8 PEM used to mint act-as assertions (Hub only). Generate with:
#   node scripts/generate-assertion-keypair.mjs --kid hub-key-1 --out ./keys
# HUB_ASSERTION_PRIVATE_KEY_FILE=
# HUB_ASSERTION_KEY_ID=
# Optional JWKS for verification/rotation; when empty, derived from the private key.
# HUB_ASSERTION_PUBLIC_KEY_FILE=
# JWKS of the bridge's service-token public keys (aud=proba-hub).
# CONTEXT_SERVICE_PUBLIC_KEY_FILE=
# Cap on GET /v1/internal/threads/{id}/messages?limit=
# HUB_INTERNAL_MESSAGES_LIMIT_CAP=100

# --- Audit trail (protocol AuditEvent via the transactional outbox) ---
# AUDIT_ENABLED=false stops writing audit events. AUDIT_RELAY_ENABLED=false keeps
# writing them to the audit_outbox table but does not publish them to Redis.
AUDIT_ENABLED=true
AUDIT_RELAY_ENABLED=true
# Where the relay publishes: redis (default, the stream below) or log (event ids to the Hub log only; no broker).
AUDIT_PUBLISHER=redis
AUDIT_STREAM=proba.audit.events
AUDIT_WORKSPACE_ID=seedbed
# Raw text of messages, replies and explanations on audit events (secrets masked, 16k max).
# Off by default; see README, Audit trail.
AUDIT_CONTENT_ENABLED=false
# When content is on: also mask emails, phones and IBANs (secrets/cards always masked). Default true.
AUDIT_CONTENT_MASK_PII=true

# --- Platform connections (Marketing: Connect Reddit; credential broker) -----------------
# Off unless HUB_CONNECTIONS_KEY_FILE is set. All secrets are FILES (chmod 600), never values here.
# Encryption key for stored refresh tokens: 64 hex chars (openssl rand -hex 32).
# HUB_CONNECTIONS_KEY_FILE=/run/proba/keys/hub-connections.key
# Reddit "web app" credentials (https://www.reddit.com/prefs/apps or the Reddit Ads developer portal).
# HUB_REDDIT_CLIENT_ID_FILE=/run/proba/keys/reddit_client_id
# HUB_REDDIT_CLIENT_SECRET_FILE=/run/proba/keys/reddit_client_secret
# Must match the redirect URI registered on the Reddit app EXACTLY (the web app's callback route).
# HUB_REDDIT_REDIRECT_URI=http://localhost:5180/marketing/reddit/callback
# Public JWKS of the Ads service key (Ads -> Hub POST /v1/internal/connections/:provider/access-token).
# HUB_ADS_SERVICE_PUBLIC_KEY_FILE=/run/proba/keys/ads-service.public.jwks.json
