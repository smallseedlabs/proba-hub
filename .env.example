# Server Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Database Configuration
DATABASE_URL=postgresql://proba:proba@localhost:5432/proba_hub
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Authentication
# JWT_SECRET signs session tokens. Use a long random value outside development
# (e.g. `openssl rand -base64 48`). Tokens are also checked against the sessions
# table, so sign-out (POST /v1/auth/logout) revokes them immediately.
JWT_SECRET=dev-secret-change-in-production
JWT_EXPIRES_IN=7d
# Failed sign-in attempts allowed per email per window (per-IP limit is 3x).
AUTH_LOGIN_RATE_LIMIT_MAX=10
AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=900000
# Password-less POST /dev/login for local development and tests. Never
# registered when NODE_ENV=production; set to false to disable it elsewhere too.
DEV_LOGIN_ENABLED=true

# CORS Configuration (comma-separated list of allowed origins)
CORS_ORIGIN=http://localhost:5173

# SSE Configuration
SSE_HEARTBEAT_INTERVAL_MS=30000

# Ask Configuration
ASK_EXPIRY_CHECK_INTERVAL_MS=60000

# Mock Brain Configuration
MOCK_BRAIN_SCENARIO=happy_path
