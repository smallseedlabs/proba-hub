# Server Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Database Configuration
DATABASE_URL=postgresql://proba:replace-with-your-POSTGRES_PASSWORD@localhost:5432/proba_hub
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis Configuration
# Redis always needs a password: docker-compose.yml starts Redis with an ACL user (REDIS_USER, REDIS_PASSWORD) and no anonymous access.
#   redis://<user>:<password>@host:6379    plain TCP (inside a private network only)
#   rediss://<user>:<password>@host:6380   TLS (certificate and host name are verified; for a private CA set NODE_EXTRA_CA_CERTS)
# With NODE_ENV=production a REDIS_URL without a password makes the Hub refuse to start (RedisPasswordRequiredError).
# Use a URL-safe password (hex: `openssl rand -hex 24`) or percent-encode it.
# `scripts/generate-local-env.sh` writes a whole local .env (random passwords) that matches docker-compose.yml.
REDIS_URL=redis://proba:replace-with-your-REDIS_PASSWORD@localhost:6379
# Read by docker compose only (it builds the URLs of the containers from them):
# POSTGRES_PASSWORD=
# REDIS_USER=proba
# REDIS_PASSWORD=

# Authentication
# Users sign in with Firebase Authentication in proba-web. The Hub verifies the
# Firebase ID token against Google's public keys (no service account needed)
# and exchanges it for its own revocable session token (POST /v1/auth/session).
# FIREBASE_PROJECT_ID is the Firebase project ID (Project settings > General).
# Sign-in is disabled (503) while it is empty.
FIREBASE_PROJECT_ID=
# Optional: only verified emails in these domains may sign in (comma-separated).
# Empty allows every user of the Firebase project.
AUTH_ALLOWED_EMAIL_DOMAINS=
# JWT_SECRET signs Hub session tokens. Use a long random value outside
# development (e.g. `openssl rand -base64 48`). Tokens are also checked against
# the sessions table, so sign-out (POST /v1/auth/logout) revokes them immediately.
# JWT_SECRET_FILE (path to a file, e.g. /run/secrets/jwt_secret) takes precedence.
# With NODE_ENV=production the Hub refuses to start on this development default.
JWT_SECRET=dev-secret-change-in-production
JWT_EXPIRES_IN=7d
# Failed session exchanges allowed per IP per window.
AUTH_SESSION_RATE_LIMIT_MAX=30
AUTH_SESSION_RATE_LIMIT_WINDOW_MS=900000
# Password-less POST /dev/login for local development and tests. Never
# registered when NODE_ENV=production; set to false to disable it elsewhere too.
DEV_LOGIN_ENABLED=true

# CORS Configuration (comma-separated list of allowed origins)
CORS_ORIGIN=http://localhost:5173

# SSE Configuration
SSE_HEARTBEAT_INTERVAL_MS=30000

# Ask Configuration
ASK_EXPIRY_CHECK_INTERVAL_MS=60000

# Brain
# BRAIN_PROVIDER picks the adapter behind src/brain/port.ts: mock (default) or deepseek.
BRAIN_PROVIDER=mock
# Scripted scenario run by the mock provider
MOCK_BRAIN_SCENARIO=happy_path
# deepseek provider: the key is required (DEEPSEEK_API_KEY_FILE, a mounted secret, wins over DEEPSEEK_API_KEY).
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_TIMEOUT_MS=30000
# Limits on what a model-backed brain may propose (USD; 0 = no cap). Over-limit proposals are replaced by a short reply.
# BRAIN_MAX_OUTPUT_TOKENS=1500
# BRAIN_MAX_TOOL_CALLS=2
# BRAIN_MAX_ACTION_SPEND=1000
# BRAIN_MAX_PLAN_BUDGET=10000
# Comma-separated tool names the brain may propose; empty = any name (every call still needs approval)
# BRAIN_ALLOWED_TOOLS=
# BRAIN_MAX_CONTEXT_MESSAGES=20

# --- Audit trail (protocol AuditEvent via the transactional outbox) ---
# AUDIT_ENABLED=false stops writing audit events. AUDIT_RELAY_ENABLED=false keeps
# writing them to the audit_outbox table but does not publish them to Redis.
AUDIT_ENABLED=true
AUDIT_RELAY_ENABLED=true
# Where the relay publishes: redis (default, the stream below) or log (event ids to the Hub log only; no broker).
AUDIT_PUBLISHER=redis
AUDIT_STREAM=proba.audit.events
AUDIT_WORKSPACE_ID=seedbed
# Raw text of messages, replies and explanations on audit events (secrets masked, 16k max).
# Off by default; see README, Audit trail.
AUDIT_CONTENT_ENABLED=false
# When content is on: also mask emails, phones and IBANs (secrets/cards always masked). Default true.
AUDIT_CONTENT_MASK_PII=true
