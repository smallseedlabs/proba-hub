{
  "name": "@smallseedlabs/proba-hub",
  "version": "0.1.0",
  "description": "Proba Interaction Hub - Protocol service for AI-native ad testing",
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "migrate": "node --loader tsx src/db/migrate.ts",
    "seed": "node --loader tsx src/db/seed.ts",
    "test": "NODE_ENV=test vitest run",
    "test:watch": "NODE_ENV=test vitest",
    "test:integration": "NODE_ENV=test vitest run --config vitest.integration.config.ts",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "docker:build": "docker build -t proba-hub:latest .",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f hub"
  },
  "keywords": [
    "proba",
    "ai",
    "ads",
    "protocol",
    "microservice"
  ],
  "author": "Small Seed Labs",
  "license": "MIT",
  "dependencies": {
    "@smallseedlabs/proba-protocol": "github:smallseedlabs/proba-protocol#v0.1.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.1",
    "fastify": "^4.28.1",
    "pg": "^8.12.0",
    "redis": "^4.7.0",
    "pino": "^9.3.2",
    "pino-pretty": "^11.2.2",
    "dotenv": "^16.4.5",
    "js-yaml": "^4.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "@types/pg": "^8.11.6",
    "@types/js-yaml": "^4.0.9",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "tsx": "^4.17.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5",
    "testcontainers": "^10.11.0"
  }
}
