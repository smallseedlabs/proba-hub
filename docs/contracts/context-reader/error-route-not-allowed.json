{
  "description": "A context-reader token on a public Hub route is not accepted (session authenticator refuses it).",
  "request": {
    "method": "GET",
    "path": "/v1/goals",
    "headers": {
      "Authorization": "Bearer <service token>",
      "X-Act-As": "<act-as assertion>"
    }
  },
  "response": {
    "status": 401,
    "body": {
      "error": "invalid_token"
    }
  }
}
